{
  "openapi": "3.0.0",
  "info": {
    "title": "AquaWatch API",
    "version": "1.0.0",
    "description": "Citizen-powered waterlogging intelligence platform for Bangalore",
    "contact": {
      "name": "AquaWatch Team",
      "url": "https://aquawatch.in"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Development server"
    },
    {
      "url": "https://api.aquawatch.in",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Incidents",
      "description": "Water incident reporting and management"
    },
    {
      "name": "Hotspots",
      "description": "Waterlogging hotspot detection"
    },
    {
      "name": "Statistics",
      "description": "Analytics and statistics"
    },
    {
      "name": "Health",
      "description": "Health check endpoints"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "status": { "type": "string" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "database": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string" },
                        "latency": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service is unhealthy"
          }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "tags": ["Incidents"],
        "summary": "Get all incidents",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["reported", "under_review", "in_progress", "resolved"]
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          {
            "name": "issueType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["waterlogging", "blocked_drain", "overflow", "visible_leak"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of incidents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "count": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Incident" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Incidents"],
        "summary": "Create new incident",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["issueType", "description", "latitude", "longitude"],
                "properties": {
                  "issueType": {
                    "type": "string",
                    "enum": ["waterlogging", "blocked_drain", "overflow", "visible_leak"]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 500
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "severity": {
                    "type": "string",
                    "enum": ["low", "medium", "high"],
                    "default": "medium"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Incident created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Incident" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/incidents/{id}": {
      "get": {
        "tags": ["Incidents"],
        "summary": "Get incident by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Incident details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Incident" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Incident not found"
          }
        }
      },
      "patch": {
        "tags": ["Incidents"],
        "summary": "Update incident status",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["reported", "under_review", "in_progress", "resolved"]
                  },
                  "verificationStatus": {
                    "type": "string",
                    "enum": ["unverified", "verified", "disputed"]
                  },
                  "resolutionNote": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Incident updated"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Incident not found"
          }
        }
      },
      "delete": {
        "tags": ["Incidents"],
        "summary": "Delete incident",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Incident deleted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Incident not found"
          }
        }
      }
    },
    "/api/hotspots": {
      "get": {
        "tags": ["Hotspots"],
        "summary": "Get detected hotspots",
        "parameters": [
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000,
              "default": 500
            }
          },
          {
            "name": "timeWindow",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            }
          },
          {
            "name": "minIncidents",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100,
              "default": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of hotspots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "count": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Hotspot" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["Statistics"],
        "summary": "Get comprehensive statistics",
        "responses": {
          "200": {
            "description": "Statistics data"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "Incident": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "issueType": { "type": "string" },
          "description": { "type": "string" },
          "location": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "coordinates": {
                "type": "array",
                "items": { "type": "number" }
              }
            }
          },
          "severity": { "type": "string" },
          "status": { "type": "string" },
          "ward": { "type": "string" },
          "wardId": { "type": "string" },
          "evidenceUrl": { "type": "string" },
          "verificationStatus": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Hotspot": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "location": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "coordinates": {
                "type": "array",
                "items": { "type": "number" }
              }
            }
          },
          "issueType": { "type": "string" },
          "incidentCount": { "type": "integer" },
          "priorityScore": { "type": "number" },
          "explanation": { "type": "string" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "limit": { "type": "integer" },
          "skip": { "type": "integer" },
          "page": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "hasNextPage": { "type": "boolean" },
          "hasPrevPage": { "type": "boolean" }
        }
      }
    }
  }
}
